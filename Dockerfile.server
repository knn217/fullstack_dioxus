# syntax=docker/dockerfile:1

# Stage 1: base with cargo-chef
FROM ghcr.io/lewimbes/dioxus-docker:latest AS chef
# Prebuilt binary instead of compiling cargo-chef from source.
# If this path doesn't match your base image's cargo home, fall back to: RUN cargo install cargo-chef --locked
COPY --from=lukemathwalker/cargo-chef:latest-rust-1 /usr/local/cargo/bin/cargo-chef /usr/local/cargo/bin/cargo-chef
# Set here so planner, deps and builder all inherit identical values (needed for matching fingerprints).
# Less debug info and no incremental artifacts means a much smaller target/ to cache.
ENV CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_RELEASE_DEBUG=0
WORKDIR /web_builder

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Dependency-only stage: this is the only stage exported to the GHA cache
FROM chef AS deps
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY --from=planner /web_builder/recipe.json recipe.json
RUN rustup target add wasm32-unknown-unknown
# Adjust feature names to match web/Cargo.toml, and mirror whatever
# `dx bundle --release --package=web --verbose` prints locally.
RUN cargo chef cook --release --package=web --no-default-features --features server --recipe-path=recipe.json
RUN cargo chef cook --release --package=web --no-default-features --features web --target wasm32-unknown-unknown --recipe-path=recipe.json

# App build stage: changes every run, never exported to cache
FROM deps AS builder
COPY . .

# Install Syft for SBOM generation
RUN curl -sSfL https://get.anchore.io/syft | sh -s -- -b /usr/local/bin

# Build the Dioxus application bundle
# Log how many crates dx had to compile. With a matching cook this should be a handful, not hundreds.
RUN dx bundle --release --package=web 2>&1 | tee /tmp/dx.log \
    && echo "=== CACHE CHECK: dx bundle compiled $(grep -c 'Compiled \[' /tmp/dx.log) crates ===" \
    && grep -E 'Compiled \[[0-9]+/[0-9]+\]' /tmp/dx.log | tail -n 1

# Generate comprehensive SBOMs
RUN mkdir -p /sbom-output \
    && syft dir:/web_builder/target/dx/web/release/web -o cyclonedx-json=/sbom-output/sbom-runtime.json \
    && syft dir:/web_builder/target/dx/web/release/web -o spdx-json=/sbom-output/sbom-runtime.spdx.json \
    && syft dir:. \
    --exclude './target/**' \
    --exclude './artifacts/**' \
    --exclude './.git/**' \
    -o cyclonedx-json=/sbom-output/sbom-source.json

# Dedicated stage solely for exporting SBOMs to the host
FROM scratch AS sbom-export
COPY --from=builder /sbom-output /

# Minimal runtime image
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies and CA certificates
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libssl3 \
        ca-certificates \
        && \
    rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Copy the built Dioxus server application and assets
COPY --from=builder /web_builder/target/dx/web/release/web /app/web

# Copy generated SBOMs into the runtime image
COPY --from=builder /web_builder/sbom-*.json /app/

# Set ownership to non-root user
RUN chown -R appuser:appuser /app

# Add OCI metadata labels
LABEL org.opencontainers.image.title="Dioxus Fullstack Server" \
      org.opencontainers.image.description="Dioxus web application server" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.source="https://github.com/yourcompany/your-repo"

# Switch to non-root user
USER appuser

ENTRYPOINT ["/app/web/server"]
EXPOSE 8080